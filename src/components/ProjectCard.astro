---
const { url, title, image, category } = Astro.props;
---

<a class="card" href={url} data-category={category}>
  <img src={image.url} alt={image.alt} loading="lazy" />
  <div class="meta">
    <span>{title}</span>
    <span class="muted">{category}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card[hidden] {
    display: none;
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 6px;
    background: var(--card);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
  }
</style>

---
const { url, title, image, category, external = false } = Astro.props;
---

<a
  class="card"
  href={url}
  data-category={category}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {
    image ? (
      <img src={image.url} alt={image.alt} loading="lazy" />
    ) : (
      <div class="thumb" aria-hidden="true">{title}</div>
    )
  }
  <div class="meta">
    <span>{title}{external && <span class="muted"> ↗</span>}</span>
    <span class="muted">{category}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card[hidden] {
    display: none;
  }

  img,
  .thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    background: var(--card);
  }

  img {
    object-fit: cover;
  }

  .thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
  }

  .meta > .muted {
    flex-shrink: 0;
    white-space: nowrap;
  }
</style>

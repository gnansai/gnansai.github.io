---
import { navItems } from "../data/navItems.js";

import { socialLinks } from "../data/socialLinks_svg.js";
import Logo from "../../public/icons/Threejs_Icon.svg";
---

<!-- data-astro-reload -->
<nav class="navbar navbar-expand-md fixed-top blurTest">
  <div class="container">
    <a id="navbrand" class="navbar-brand px-3" href="/">GnanaSai</a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarsExample"
      aria-controls="navbarsExample"
      aria-expanded="false"
      aria-label="Toggle navigation "
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarsExample">
      <ul id="navList" class="navbar-nav ms-auto me-auto mb-0 mb-sm-0">
        {
          navItems.map((item) => (
            <li class="nav-item">
              <a class="nav-link px-3" href={item.link} data-nav={item.link}>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="navbar-nav" style="flex-direction: row;">
        {
          socialLinks.map((item) => (
            <li class="nav-item">
              <a
                class="nav-link px-2"
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {/* <Logo width={24} height={24} fill="currentColor" /> */}
                {/* <img class="navIcon" src={item.img.src} alt={item.img.alt}/> */}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="currentColor"
                  viewBox="0 0 16 16"
                >
                  <path d={item.svgPath} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="form-check form-switch">
        <input class="checkbox" type="checkbox" id="darkModeSwitch" />
        <label class="checkbox-label" for="darkModeSwitch">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="#f39c12"
            class="bi bi-sun-fill"
            viewBox="0 0 16 16"
          >
            <path
              d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"
            ></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="#aaaaaa"
            class="bi bi-moon-fill"
            viewBox="0 0 16 16"
          >
            <path
              d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"
            ></path>
          </svg>
          <span class="ball"></span>
        </label>
      </div>
    </div>
  </div>
</nav>

<style>
  .blurTest {
    backdrop-filter: blur(20px);
    background-color: rgba(209, 209, 209, 0.158);
    /* transition: background-color 0.3s ease-in-out; */
  }

  .navIcon {
    filter: invert(50%) brightness(90%) contrast(90%);
    width: 23px;
    /* filter: var(--bs-btn-hover-icon-filter); */
  }

  .btn {
    margin-right: 8px;
  }

  .checkbox {
    opacity: 0;
    position: absolute;
  }

  .checkbox-label {
    background-color: #111;
    width: 50px;
    height: 26px;
    border-radius: 50px;
    position: relative;
    padding: 5px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .checkbox-label .ball {
    background-color: #fff;
    width: 22px;
    height: 22px;
    position: absolute;
    left: 2px;
    top: 2px;
    border-radius: 50%;
    transition: transform 0.2s linear;
  }

  .checkbox:checked + .checkbox-label .ball {
    transform: translateX(24px);
  }
</style>

<script>
  console.log(localStorage.getItem("theme"));

  document.addEventListener("astro:page-load", () => {
    const navList = document.getElementById("navList");
    const navLinks = navList.querySelectorAll(".nav-link");

    // Function to set active class
    function setActiveNav(link) {
      navLinks.forEach((nav) => nav.classList.remove("active"));
      link.classList.add("active");
    }

    navLinks.forEach(function (nav) {
      if (nav.getAttribute("data-nav") == window.location.pathname) {
        console.log(nav);
        setActiveNav(nav);
      }
    });

    const htmlElement = document.documentElement;
    const switchElement = document.getElementById("darkModeSwitch");

    const currentTheme = localStorage.getItem("bsTheme") || "dark";
    htmlElement.setAttribute("data-bs-theme", currentTheme);
    switchElement.checked = currentTheme === "dark";

    switchElement.addEventListener("change", function () {
      if (this.checked) {
        htmlElement.setAttribute("data-bs-theme", "dark");
        localStorage.setItem("bsTheme", "dark");
      } else {
        htmlElement.setAttribute("data-bs-theme", "light");
        localStorage.setItem("bsTheme", "light");
      }
    });
  });
</script>

<script is:inline>
  const switchElement = document.getElementById("darkModeSwitch");
  function applyTheme() {
    if (localStorage.theme === "dark") {
      document.documentElement.setAttribute("data-bs-theme", "dark");
      switchElement.checked = false;
    } else {
      document.documentElement.setAttribute("data-bs-theme", "light");
      switchElement.checked = true;
    }
  }

  document.addEventListener("astro:after-swap", applyTheme);
  applyTheme();
</script>

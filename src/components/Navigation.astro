---
import { navItems } from "../data/navItems.js";

import { socialLinks } from "../data/socialLinks.js";
---
<!-- data-astro-reload -->
<div class="container">
  <nav class="navbar navbar-expand-md fixed-top bg-body-tertiary">
    <div class="container">
      <a
        class="navbar-brand nav-item btn btn-outline-secondary nav-link px-3 py-2"
        href="/"
        >GnanaSai</a
      >
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarsExample"
        aria-controls="navbarsExample"
        aria-expanded="false"
        aria-label="Toggle navigation "
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarsExample">
        <ul class="navbar-nav ms-auto me-auto mb-0 mb-sm-0 btn-group">
          {
            navItems.map((item) => (
              <li  class="nav-item btn btn-outline-secondary nav-link px-3">
                <a  class="nav-link py-0" href={item.link}>
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="navbar-nav btn-group">
          {
            socialLinks.map((item) => (
              <li class="nav-item">
                <a
                  class="btn btn-outline-secondary nav-link"
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img class="navIcon" src={item.img.src} alt={item.img.alt} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</div>

<style>
  .navIcon {
    filter: invert(48%) sepia(79%) brightness(90%) contrast(55%);
    width: 23px;
  }

  .btn {
    margin-right: 8px;
  }
</style>

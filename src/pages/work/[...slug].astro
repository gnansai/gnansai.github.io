---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const projectEntries = await getCollection("threeDProjects", (entry) => !entry.data.liveUrl && !entry.data.postUrl);
    return projectEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, category, toolsUsed, dateCompleted, artstationUrl, embeds } = entry.data;
const year = dateCompleted?.slice(0, 4);
---

<BaseLayout pageTitle={title}>
  <article class="wrap project">
    <a class="back muted" href="/">← All work</a>
    <header>
      <h1>{title}</h1>
      <p class="muted">{[category, year, toolsUsed.join(", ")].filter(Boolean).join(" · ")}</p>
      {
        artstationUrl && (
          <a class="external muted" href={artstationUrl} target="_blank" rel="noopener noreferrer">
            View on ArtStation ↗
          </a>
        )
      }
    </header>
    {embeds.map((src) => <iframe class="cover video" src={src} title={title} allowfullscreen />)}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  /* Same top spacing as the home page intro. */
  .project {
    padding-block: 36px 120px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (max-width: 767px) {
    .project {
      padding-block: 28px 72px;
      gap: 24px;
    }
  }

  .back {
    font-size: 15px;
  }

  h1 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 40px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  header p {
    margin: 0;
    font-size: 15px;
    text-transform: capitalize;
  }

  .cover {
    width: 100%;
    border-radius: 6px;
    background: var(--card);
  }

  .video {
    display: block;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .prose {
    font-size: 17px;
  }

  .prose :global(p) {
    max-width: 720px;
    margin: 0 0 1.4em;
  }

  .prose :global(h2) {
    margin: 2.4em 0 0.3em;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.01em;
    /* Clear the sticky header when jumped to. */
    scroll-margin-top: 100px;
  }

  .prose :global(.jump) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 1.4em;
  }

  .prose :global(.jump a) {
    min-width: 44px;
    height: 44px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--btn-line);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .prose :global(.jump a:hover) {
    border-color: var(--accent);
  }

  .prose :global(h2 + p) {
    font-size: 15px;
  }

  /* Markdown wraps images in a <p>; let those go full width. */
  .prose :global(p:has(img)) {
    max-width: none;
  }

  .prose :global(img),
  .prose :global(iframe),
  .prose :global(video) {
    width: 100%;
    height: auto;
    margin: 0 0 1.4em;
    border-radius: 6px;
    background: var(--card);
  }

  .prose :global(iframe) {
    display: block;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .prose :global(video) {
    display: block;
  }

  .prose :global(figure) {
    margin: 0 0 1.4em;
  }

  .prose :global(figure) :global(video) {
    margin-bottom: 8px;
  }

  .prose :global(figcaption) {
    font-size: 14px;
    color: var(--muted);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .external {
    display: inline-block;
    margin-top: 8px;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

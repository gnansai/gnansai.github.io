---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main>
    <div class="h-screen w-screen" style="height: 512px;" id="container"></div>
  </main>
</BaseLayout>

<script>
  import { Sketch } from "../scripts/world.js";
  let sketch = new Sketch({
    domElement: document.getElementById("container"),
  });

  //   sketch.render();
  sketch.resize();
  sketch.addObjects();
  sketch.render();
  sketch.setupResize();
  let x = 1;
  console.log(x);

  document.addEventListener("astro:page-load", () => {
    if (document.getElementById("container")) {
      x = x + 1;
	  sketch.container =  document.getElementById("container");
      sketch.resize();
      sketch.addObjects();
      sketch.render();
      sketch.setupResize();
	  console.log(sketch);
    }
  });
</script>

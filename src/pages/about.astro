---
// import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "About Me";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{pageTitle}</title>
  <link rel="stylesheet" href="../styles/global.css" />
</head>
<body>
  <BaseLayout>
    <section>
      <div class="container text-center mt-5">
        <!-- Image section -->
        <img src="gnana-sai-reddy-a-2-worlds-24.webp" class="img-fluid rounded-circle mb-4" alt="Gnana Sai" width="200"/>
        <h2>Gnana Sai</h2>
        <p class="mt-3">I am a 3D Generalist specializing in creating immersive and engaging visuals using Blender as my primary tool. My passion lies in transforming ideas into stunning 3D art.</p>
        <br />
        <!-- Tools section -->
        <h4>Tools that I use</h4>
        <div class="mt-3">
          <ul class="list-inline">
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Blender</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Krita</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Substance Painter</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Davinci Resolve</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">After Effects</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Three.js</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">BabylonJS</li>
          </ul>
        </div>
        <!-- Projects section -->
        <h4 class="mt-4">Types of Projects I’ve Worked On</h4>
        <div class="mt-3">
          <ul class="list-inline">
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Product PackShots</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Product Animations</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Game Art</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">WebGL</li>
            <li class="list-inline-item bg-body-secondary p-2 m-1 rounded">Product Configurators</li>
          </ul>
        </div>
        <!-- Social links -->
        <div class="mt-4">
          <h4>Connect with Me</h4>
          <ul class="list-inline">
            <li class="list-inline-item">
              <a href="https://github.com/gnansai" target="_blank" rel="noopener noreferrer">
                <img class="icon" src="../icons/github-brands.svg" width="25" alt="GitHub" />
              </a>
            </li>
            <li class="list-inline-item">
              <a href="https://www.instagram.com/artworks_for_joy/" target="_blank" rel="noopener noreferrer">
                <img class="icon" src="../icons/instagram-brands.svg" width="25" alt="Instagram" />
              </a>
            </li>
            <li class="list-inline-item">
              <a href="https://www.artstation.com/gnan-sai" target="_blank" rel="noopener noreferrer">
                <img class="icon" src="../icons/artstation-brands.svg" width="25" alt="ArtStation" />
              </a>
            </li>
            <li class="list-inline-item">
              <a href="https://www.youtube.com/c/GnanSai3DArtist/videos" target="_blank" rel="noopener noreferrer">
                <img class="icon" src="../icons/youtube-brands.svg" width="25" alt="YouTube" />
              </a>
            </li>
            <li class="list-inline-item">
              <a href="https://sketchfab.com/gnanasai/models" target="_blank" rel="noopener noreferrer">
                <img class="icon" src="../icons/sketchfab-logo-black.svg" width="25" alt="Sketchfab" />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </BaseLayout>
</body>
</html>

<style>
  .icon {
    filter: invert(48%);
    transition: filter 0.3s; /* Smooth transition for filter changes */
  }

  /* Add hover effect */
  /* .icon:hover {
    filter: brightness(0) invert(1); 
  } */
</style>

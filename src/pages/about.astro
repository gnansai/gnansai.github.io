---
import BaseLayout from "../layouts/BaseLayout.astro";
import { email, socialLinks } from "../data/socialLinks.js";
import { softwares } from "../data/softwares.js";
import { projectTypes } from "../data/porjectTypes.js";
---

<BaseLayout pageTitle="About">
  <section class="wrap intro">
    <h1>About</h1>
    <p class="lead">
      I'm Gnana Sai, a freelance 3D artist with a background in visual communication and animation.
      I've delivered 79 projects for clients worldwide — product models, renders, animations and
      real-time web experiences. Blender is my main tool; Three.js takes it to the browser.
    </p>
  </section>

  <section class="wrap block">
    <h2 class="section-label">Tools</h2>
    <ul class="tags">
      {softwares.map((item) => <li>{item.name}</li>)}
    </ul>
  </section>

  <section class="wrap block">
    <h2 class="section-label">Projects I work on</h2>
    <ul class="tags">
      {projectTypes.map((item) => <li>{item.name}</li>)}
    </ul>
  </section>

  <section class="wrap block">
    <h2 class="section-label">Elsewhere</h2>
    <ul class="links">
      {
        socialLinks.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener noreferrer">
              {item.name} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    email && (
      <section id="contact" class="wrap block">
        <h2 class="section-label">Contact</h2>
        <p class="lead">
          Have a project in mind? <a class="accent" href={`mailto:${email}`}>{email}</a>
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .intro {
    padding-block: 96px 80px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    margin: 0;
    font-weight: 500;
    font-size: 40px;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    max-width: 720px;
    font-size: 20px;
    line-height: 1.55;
  }

  .block {
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .block:last-of-type {
    padding-bottom: 120px;
  }

  .tags,
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
  }

  .tags {
    gap: 8px;
  }

  .tags li {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 15px;
  }

  .links {
    gap: 8px 28px;
    font-size: 17px;
  }

  .accent {
    color: var(--accent);
  }
</style>

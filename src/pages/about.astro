---
import { navItems } from "../data/navItems.js";

import { socialLinks } from "../data/socialLinks.js";

import { softwares } from "../data/softwares";

import { projectTypes } from "../data/porjectTypes";

import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "About Me";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
   
  </head>
  <body>
    <BaseLayout>
      <section>
        <div class="container text-center mt-5">
          <!-- Image section -->
          <img
            src="gnana-sai-reddy-a-2-worlds-24.webp"
            class="img-fluid rounded-circle mb-4"
            alt="Gnana Sai"
            width="200"
          />
          <h2>Gnana Sai</h2>
          <p class="mt-3">
            I am a 3D Generalist specializing in creating immersive and engaging
            visuals using Blender as my primary tool. My passion lies in
            transforming ideas into stunning 3D art.
          </p>
          <br />
          <!-- Tools section -->
          <h4>Tools that I use</h4>
          <div class="mt-3">
            <ul class="list-inline">
              {
                softwares.map((item) => (
                  <li class="list-inline-item bg-body-tertiary p-2 m-1 rounded">
                    {item.name}
                  </li>
                ))
              }
            </ul>
          </div>
          <!-- Projects section -->
          <h4 class="mt-4">Types of Projects I’ve Worked On</h4>
          <div class="mt-3">
            <ul class="list-inline">
              {
                projectTypes.map((item) => (
                  <li class="list-inline-item bg-body-tertiary p-2 m-1 rounded">
                    {item.name}
                  </li>
                ))
              }
            </ul>
          </div>
          <!-- Social links -->
          <div class="mt-4">
            <h4>Connect with Me</h4>
            <ul class="list-inline">
              {
                socialLinks.map((item) => (
                  <li class="list-inline-item">
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <img
                        class="icon"
                        src={item.img.src}
                        width="25"
                        alt={item.img.alt}
                      />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>
    </BaseLayout>
  </body>
</html>

<style>
  .icon {
    filter: invert(48%);
    transition: filter 0.3s; /* Smooth transition for filter changes */
  }

  /* Add hover effect */
  /* .icon:hover {
    filter: brightness(0) invert(1); 
  } */
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { email, socialLinks } from "../data/socialLinks.js";
import { softwares } from "../data/softwares.js";
import { projectTypes } from "../data/porjectTypes.js";
import { experience } from "../data/experience.js";

const upwork = socialLinks.find((item) => item.name === "Upwork");
---

<BaseLayout pageTitle="About">
  <div class="wrap about">
    <aside class="profile">
      <img class="photo" src="/about/gnana-sai.jpg" alt="Gnana Sai in the mountains" width="400" height="400" />
      <div class="who">
        <p class="name">Gnana Sai</p>
        <p class="muted">3D Technical Artist</p>
        <p class="muted">Based in India, working worldwide</p>
      </div>
      {
        upwork && (
          <a class="cta" href={upwork.link} target="_blank" rel="noopener noreferrer">
            Hire me on Upwork ↗
          </a>
        )
      }
    </aside>

    <div class="content">
      <h1>About</h1>
      <p class="lead">
        I'm Gnana Sai, a freelance 3D artist with a background in visual communication and animation.
        I've delivered 70 projects for clients worldwide — product models, renders, animations and
        real-time web experiences.
      </p>

      <dl class="rows">
        <div class="row">
          <dt>Experience</dt>
          <dd>
            <ol class="jobs">
              {
                experience.map((job) => (
                  <li class="job">
                    <div class="job-head">
                      <span class="job-role">{job.role}</span>
                      <span class:list={["job-dates", { current: !job.end }]}>
                        {job.start} – {job.end || "Present"}
                      </span>
                    </div>
                    <p class="muted">
                      {job.link ? (
                        <a href={job.link} target="_blank" rel="noopener noreferrer">
                          {job.company}
                        </a>
                      ) : (
                        job.company
                      )}{" "}
                      · {job.type} · {job.location}
                    </p>
                    {job.description && <p class="job-desc">{job.description}</p>}
                    {job.stats && <p class="job-stats">{job.stats.join(" · ")}</p>}
                  </li>
                ))
              }
            </ol>
          </dd>
        </div>

        <div class="row">
          <dt>Tools</dt>
          <dd>
            <ul class="tags">
              {softwares.map((item) => <li>{item.name}</li>)}
            </ul>
          </dd>
        </div>

        <div class="row">
          <dt>Projects I work on</dt>
          <dd>
            <ul class="tags">
              {projectTypes.map((item) => <li>{item.name}</li>)}
            </ul>
          </dd>
        </div>

        <div class="row">
          <dt>Elsewhere</dt>
          <dd>
            <ul class="links">
              {
                socialLinks.map((item) => (
                  <li>
                    <a href={item.link} target="_blank" rel="noopener noreferrer">
                      {item.name} ↗
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>

        {
          email && (
            <div class="row" id="contact">
              <dt>Contact</dt>
              <dd>
                <a class="accent" href={`mailto:${email}`}>{email}</a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    padding-block: 36px 120px;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  /* Profile card stays in view under the sticky header. */
  .profile {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    background: var(--card);
  }

  .who p {
    margin: 0;
    font-size: 15px;
  }

  .who .name {
    margin-bottom: 2px;
    font-size: 17px;
    font-weight: 600;
  }

  .cta {
    min-height: 44px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--btn-line);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
  }

  .cta:hover {
    border-color: var(--accent);
  }

  h1 {
    margin: 0 0 20px;
    font-weight: 500;
    font-size: 40px;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0 0 48px;
    max-width: 640px;
    font-size: 20px;
    line-height: 1.55;
  }

  .rows {
    margin: 0;
  }

  .row {
    padding-block: 24px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 12px 24px;
  }

  .row dt {
    padding-top: 7px;
    font-size: 15px;
    color: var(--muted);
  }

  .row dd {
    margin: 0;
  }

  .jobs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .job {
    padding-block: 4px 16px;
  }

  .job + .job {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .job:last-child {
    padding-bottom: 0;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }

  .job-role {
    font-size: 17px;
    font-weight: 500;
  }

  .job-dates {
    font-size: 15px;
    color: var(--muted);
    white-space: nowrap;
  }

  .job-dates.current {
    color: var(--fg);
  }

  .job p {
    margin: 2px 0 0;
    font-size: 15px;
  }

  .job .muted a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .job .muted a:hover {
    color: var(--accent);
  }

  .job-desc {
    max-width: 560px;
    margin-top: 8px !important;
  }

  .job-stats {
    margin-top: 6px !important;
    font-weight: 500;
  }

  .tags,
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
  }

  .tags {
    gap: 8px;
  }

  .tags li {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 15px;
  }

  .links {
    padding-top: 6px;
    gap: 8px 24px;
    font-size: 16px;
  }

  .accent {
    display: inline-block;
    padding-top: 6px;
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    /* Photo beside the name instead of above it. */
    .profile {
      position: static;
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      align-items: center;
      gap: 16px 20px;
    }

    .cta {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .row dt {
      padding-top: 0;
    }
  }

  @media (max-width: 767px) {
    .about {
      padding-block: 28px 72px;
    }

    h1 {
      font-size: 32px;
    }

    .lead {
      margin-bottom: 32px;
      font-size: 17px;
    }
  }
</style>

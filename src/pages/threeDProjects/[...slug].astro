---
import { getCollection } from "astro:content";
// import MarkdownWorksLayout from "../../layouts/MarkdownWorksLayout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThreeDProjectLayout from "../../layouts/threeDProjectLayout.astro";


export const prerender = true;
export async function getStaticPaths() {
    const projectEntries = await getCollection("threeDProjects");
    return projectEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<ThreeDProjectLayout frontmatter={entry.data}>
<h1>{entry.data.description}</h1>
<Content />

</ThreeDProjectLayout>